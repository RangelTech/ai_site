---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BrazilMap from '../components/BrazilMap.astro';
import Quiz from '../components/Quiz.astro';
import lucas from '../assets/lucas.jpg';
import { ICON } from '../lib/icons';
import { MOTIFS } from '../lib/motifs';
import { PROJETOS, FAQ } from '../data/content';
import { QUIZ, VAGAS, PRECOS, PRECOS_DE, VIDEO, LINKS, VIDEOS_CLIENTES, NUMEROS, PROVA_VISIVEL, VIDEOS_VISIVEIS } from '../data/config';
import { EMPRESAS_INFO } from '../data/empresas_info';
import { vagasRestantes, fraseVagas, fraseVagasCurta, mentoradosRestantes, fraseMentorados, TOTAL_MENTORADOS } from '../lib/mes';
import { carregarProva } from '../lib/prova';

const prova = await carregarProva();
const n = prova.numeros;
const restantes = vagasRestantes();
const mRestantes = mentoradosRestantes();
const brl = (v: number) => 'R$ ' + v.toLocaleString('pt-BR');
const off = (de: number, por: number) => Math.round((1 - por / de) * 100);
const destaques = PROJETOS.filter((p) => p.destaque).sort((a, b) => a.destaque! - b.destaque!);
const extras = PROJETOS.filter((p) => !p.destaque);
const iniciais = (s: string) => s.replace(/[^A-Za-zÀ-ú ]/g, '').split(' ').filter(Boolean).map((x) => x[0]).join('').slice(0, 2).toUpperCase();
const PASSOS = [
  { n: '01', t: 'Você me conta o problema', d: 'O quiz leva dois minutos. No fim, eu já sei de onde você está falando.' },
  { n: '02', t: 'A gente fecha o escopo', d: 'Na call de 30 minutos ou na primeira conversa: o que entra, o que não entra, em quanto tempo.' },
  { n: '03', t: 'Eu resolvo para você', d: 'Eu conecto, construo e subo. Você acompanha, eu te mostro como funciona, e no fim está no ar e você sabendo operar.' },
];
---
<Base>
  <!-- 1. Hero: a promessa e a primeira pergunta do quiz -->
  <section class="hero" id="topo" data-sec="hero" data-hue="0">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>Lucas Rangel · Mais de 12 anos resolvendo problemas com IA · mais de 50 empresas</p>
        <h1 class="display h1" data-split>Qual é o seu problema? <em class="hot">Eu resolvo para você.</em></h1>
        <p class="lead" data-reveal>Não é curso. Não é vídeo gravado. É eu, com 12 anos de inteligência artificial aplicada, resolvendo o que está travando a sua vida ou a sua empresa. Se você quiser, eu faço por você.</p>
        <p class="hero__ask" data-reveal>Me diz onde você está hoje:</p>
        <div class="situ" data-reveal role="group" aria-label="Qual é a sua situação hoje?">
          {QUIZ.situacoes.map((s) => (
            <button type="button" class="situ__b" data-quiz data-situacao={s.id} data-track={`hero_${s.id}`}><b>{s.label}</b><span>{s.sub}</span><i set:html={ICON.chevron} /></button>
          ))}
        </div>
        <p class="hero__trust" data-reveal><Fragment set:html={ICON.shield} /><span>Garantia de 7 dias. <b data-vagas-curta>{fraseVagasCurta(restantes)}</b> para o cara a cara este mês.</span></p>
      </div>
      <div class="hero__brain" data-reveal aria-hidden="true">
        <canvas data-cerebro="hero"></canvas>
      </div>
      <ul class="hero__nums" data-reveal aria-label="Números">
        <li><b data-count={n.mentorados + NUMEROS.empresas}>{n.mentorados + NUMEROS.empresas}</b><span>problemas resolvidos</span></li>
        <li><b data-count={NUMEROS.empresas}>{NUMEROS.empresas}</b><span>empresas atendidas</span></li>
        <li><b>{NUMEROS.artigos}+</b><span>artigos técnicos publicados</span></li>
        <li><b data-count={NUMEROS.anosIA}>{NUMEROS.anosIA}</b><span>anos só com IA, {NUMEROS.anosTec} em tecnologia</span></li>
      </ul>
    </div>
  </section>

  <!-- 2. Quem sou eu: foto (ou vídeo, quando chegar) que aproxima conforme a rolagem, com as frases ao lado -->
  <section class="sec cena" id="sobre" data-sec="sobre" data-hue="1" data-cena>
    <div class="wrap cena__grid">
      <div class="cena__card" data-cena-media>
        <Image src={lucas} widths={[600, 900, 1400]} sizes="(min-width: 960px) 46vw, 92vw" format="webp" quality={72} alt="Lucas Rangel" loading="lazy" />
        <canvas data-cena-canvas hidden></canvas>
        <div class="cena__shade"></div>
        <div class="cena__tag"><b>Lucas Rangel</b><span>Fundador da Rangel Tech</span></div>
        {VIDEO.mp4 && <a class="btn btn--ghost btn--sm cena__play" href={VIDEO.mp4} data-track="video_play">Assistir com som</a>}
      </div>
      <div class="cena__text">
        <span class="eyebrow" data-reveal>Quem sou eu</span>
        <h2 class="display h2" data-reveal>Prazer, <em class="hot">Lucas Rangel.</em></h2>
        <ul class="cena__caps">
          {VIDEO.legendas.map((l, i) => <li class="cena__cap" data-cena-cap={i} data-reveal>{l}</li>)}
        </ul>
        <p class="lead" data-reveal>Meu papel é resolver, não dar aula. Eu abro a tela, conecto no seu computador, subo o sistema e te mostro como ele funciona. Você aprende no caminho, mas o problema é meu até estar resolvido.</p>
        <div class="dominio" data-reveal>
          <p class="dominio__t">Inteligência artificial não é só chat. É o que eu entrego há 12 anos:</p>
          <ul class="dominio__lista">
            <li>Agentes de IA que operam sistemas</li><li>Visão computacional</li><li>Previsão de demanda e de vendas</li><li>Voz: transcrição e fala</li><li>Imagem e vídeo gerados</li><li>Modelos próprios no seu servidor</li><li>Dados: do lago ao painel</li><li>Risco, preço e recomendação</li>
          </ul>
          <p class="dominio__p">Laboratório próprio: eu testo modelos, placas de vídeo e ferramentas, meço custo e resultado, e publico tudo: {NUMEROS.artigos}+ artigos, {NUMEROS.kaggle} conjuntos de dados no Kaggle. <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>, <a href={LINKS.kaggle} target="_blank" rel="noopener">Kaggle</a> e <a href={LINKS.portfolio} target="_blank" rel="noopener">portfólio</a>.</p>
        </div>
        <ul class="stats" data-reveal>
          <li><b>20</b><span>anos em tecnologia</span></li>
          <li><b>12</b><span>só com inteligência artificial</span></li>
          <li><b>4</b><span>setores: varejo, finanças, indústria, educação</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Quanto custa continuar como está -->
  <section class="sec" id="custo" data-sec="custo" data-hue="2">
    <div class="wrap">
      <div class="sec__head" data-reveal>
        <span class="eyebrow">Enquanto você adia</span>
        <h2 class="display h2">Quanto custa continuar <em class="hot">como está?</em></h2>
      </div>
      <ul class="custo" data-reveal>
        <li class="glass glass--m"><b>Horas</b><p>por semana fazendo na mão o que a IA faria em minutos.</p></li>
        <li class="glass glass--m"><b>Salário</b><p>que não sobe porque você faz o mesmo que todo mundo.</p></li>
        <li class="glass glass--m"><b>Clientes</b><p>que vão embora porque o seu atendimento não acompanha.</p></li>
        <li class="glass glass--m"><b>Folha</b><p>um salário inteiro, todo mês, para uma tarefa que a IA faz por uma fração.</p></li>
      </ul>
      <p class="custo__fecho display" data-reveal>Isso não melhora sozinho. <em class="hot">Melhora quando alguém resolve.</em></p>
    </div>
  </section>

  <!-- 4. Os três caminhos -->
  <section class="sec" id="caminhos" data-sec="caminhos" data-hue="3">
    <div class="wrap">
      <div class="sec__head" data-reveal>
        <span class="eyebrow">Mentorias</span>
        <h2 class="display h2">Três jeitos de eu <em class="hot">resolver o seu problema.</em></h2>
        <p class="lead">Nos três eu faço por você: conecto, construo, subo e te mostro. O que muda é quanto de mim você tem e por onde a gente fala.</p>
      </div>
      <div class="plans">
        <article class="plan plan--hi glass" id="individual" data-sec="individual" data-reveal>
          <span class="plan__badge">Mais completa</span>
          <h3 class="plan__name">Cara a cara</h3>
          <p class="plan__for">3 encontros por semana por vídeo, só nós dois, mais o WhatsApp todo dia. Eu conecto no seu computador, subo e te mostro.</p>
          <div class="price__de"><s>de {brl(PRECOS_DE.individual)}</s><span class="price__off">-{off(PRECOS_DE.individual, PRECOS.individual)}%</span></div>
          <div class="price"><small>por</small> {brl(PRECOS.individual)}</div>
          <p class="plan__pay">Antes de pagar, uma call de 30 minutos: você me conta o problema, eu te mostro como trabalho e a gente fecha o escopo.</p>
          <ul class="offer__list">
            <li><Fragment set:html={ICON.check} /><span>Você traz o problema, eu construo com você na tela até estar funcionando. Se quiser, eu faço por você</span></li>
            <li><Fragment set:html={ICON.check} /><span>Montamos contas e ambiente juntos, na tela</span></li>
            <li><Fragment set:html={ICON.check} /><span>Modelos dos projetos que eu uso nos meus clientes</span></li>
            <li><Fragment set:html={ICON.check} /><span>WhatsApp comigo e com a minha equipe, todo dia</span></li>
          </ul>
          <p class="plan__future"><b>Daqui a 90 dias:</b> o seu projeto no ar e você sabendo operar.</p>
          <div class="plan__bonus"><span class="plan__bonus-tag">Bônus de quem entra agora</span><b>3 meses grátis do Segundo Cérebro, plano Max</b><p>O meu assistente de IA que lê arquivos, roda comandos e cria sites e documentos. Eu mesmo configuro tudo para você, 100%. Na assinatura anual dos planos sem máquina virtual; depois dos 3 meses, valor normal. <a href="https://brain.rangeltech.net" target="_blank" rel="noopener">Ver os planos</a>.</p></div>
          <div class="seats">
            <div class="seats__dots" data-dots aria-hidden="true">{Array.from({ length: VAGAS.total }).map((_, i) => <i class={i < VAGAS.total - restantes ? 'taken' : ''} />)}</div>
            <p><b data-vagas-frase>{fraseVagas(restantes)}.</b> Atendo no máximo {VAGAS.total} alunos ao mesmo tempo, para dar atenção de verdade.</p>
          </div>
          <div class="plan__cta">
            <button type="button" class="btn btn--hot btn--block" data-quiz data-formato="cara_a_cara" data-track="plano_individual">Quero resolver cara a cara</button>
            <span class="plan__g"><Fragment set:html={ICON.shield} /> Garantia de 7 dias</span>
          </div>
        </article>
        <article class="plan glass" id="acompanhamento" data-sec="acompanhamento" data-reveal>
          <h3 class="plan__name">Pelo WhatsApp</h3>
          <p class="plan__for">Você manda o problema pelo WhatsApp e eu resolvo: conecto no seu computador, subo o que precisa e te mostro. No seu ritmo, sem reunião marcada.</p>
          <div class="price__de"><s>de {brl(PRECOS_DE.acompanhamento)}</s><span class="price__off">-{off(PRECOS_DE.acompanhamento, PRECOS.acompanhamento)}%</span></div>
          <div class="price"><small>por</small> {brl(PRECOS.acompanhamento)}</div>
          <p class="plan__pay"><b>2 meses</b> comigo no WhatsApp. Compra online, direto aqui. Pix ou cartão em até 12 vezes.</p>
          <ul class="offer__list">
            <li><Fragment set:html={ICON.check} /><span>Grupo no WhatsApp comigo e com a minha equipe</span></li>
            <li><Fragment set:html={ICON.check} /><span>Eu faço por você: conecto, subo, corrijo e te mostro o que fiz</span></li>
            <li><Fragment set:html={ICON.check} /><span>Eu destravo cada dúvida e cada erro, no mesmo dia</span></li>
            <li class="off"><Fragment set:html={ICON.x} /><span>Sem encontro por vídeo</span></li>
          </ul>
          <p class="plan__future"><b>Em 2 meses:</b> o que você estava adiando está no ar.</p>
          <div class="plan__bonus"><span class="plan__bonus-tag">Bônus de quem entra agora</span><b>2 meses grátis do Segundo Cérebro, plano Light</b><p>O meu assistente de IA no seu computador. Na assinatura anual dos planos sem máquina virtual; depois dos 2 meses, valor normal. <a href="https://brain.rangeltech.net" target="_blank" rel="noopener">Ver os planos</a>.</p></div>
          <div class="seats seats--m">
            <div class="seats__dots seats__dots--m" data-dots-m aria-hidden="true">{Array.from({ length: TOTAL_MENTORADOS }).map((_, i) => <i class={i < TOTAL_MENTORADOS - mRestantes ? 'taken' : ''} />)}</div>
            <p><b data-mentorados-frase>{fraseMentorados(mRestantes)}.</b> O grupo é pequeno de propósito.</p>
          </div>
          <div class="plan__cta">
            <button type="button" class="btn btn--hot btn--block" data-quiz data-formato="whatsapp" data-track="plano_acompanhamento">Quero começar pelo WhatsApp</button>
            <span class="plan__g"><Fragment set:html={ICON.shield} /> Garantia de 7 dias</span>
          </div>
        </article>
        <article class="plan plan--b2b glass" id="empresa" data-sec="b2b" data-reveal>
          <h3 class="plan__name">Para a sua empresa</h3>
          <p class="plan__for">Tem um problema na sua empresa que ninguém resolveu? Atendimento que não dá conta, venda que depende de gente, sistema velho que trava a operação. E tarefa que hoje custa um salário inteiro e a IA faz por uma fração, sem férias, sem erro e sem folha. Eu entrego a solução pronta, rodando dentro da sua própria estrutura, sem serviço de terceiros.</p>
          <div class="price price--s">Sob proposta</div>
          <p class="plan__pay">A gente coloca no papel antes de começar: o que entra, prazo e investimento.</p>
          <ul class="offer__list">
            <li><Fragment set:html={ICON.check} /><span>Software sob medida, atendimento automático ou força de vendas inteligente</span></li>
            <li><Fragment set:html={ICON.check} /><span>Rodando no seu ambiente, do protótipo à produção, com a sua equipe sabendo operar</span></li>
            <li><Fragment set:html={ICON.check} /><span>Eu e a minha equipe, com contrato</span></li>
          </ul>
          <p class="plan__future"><b>Daqui a 90 dias:</b> o que custava um salário por mês rodando sozinho, por uma fração do custo.</p>
          <div class="plan__cta">
            <button type="button" class="btn btn--hot btn--block" data-quiz data-situacao="empresa" data-track="plano_empresa">Quero uma proposta</button>
            <span class="plan__g"><Fragment set:html={ICON.shield} /> Escopo fechado antes de começar</span>
          </div>
        </article>
      </div>
      <div class="cmp glass glass--m" data-reveal role="table" aria-label="Lado a lado">
        <div class="cmp__row cmp__head" role="row"><span role="columnheader">Lado a lado</span><span role="columnheader">WhatsApp<br /><s class="cmp__de">{brl(PRECOS_DE.acompanhamento)}</s> <b>{brl(PRECOS.acompanhamento)}</b></span><span role="columnheader" class="hi">Cara a cara<br /><s class="cmp__de">{brl(PRECOS_DE.individual)}</s> <b>{brl(PRECOS.individual)}</b></span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Duração</span><span role="cell">2 meses</span><span role="cell" class="hi">Combinada na call, conforme o escopo</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Como a gente fala</span><span role="cell">Pelo WhatsApp, no seu horário</span><span role="cell" class="hi">3 encontros por semana por vídeo + WhatsApp</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Seu projeto</span><span role="cell">Eu faço por você, pelo WhatsApp</span><span role="cell" class="hi">Eu faço com você, na tela, 3 vezes por semana</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Contas e ambiente</span><span role="cell">Eu conecto e subo para você</span><span role="cell" class="hi">Montamos juntos, na tela</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Modelos de projeto dos meus clientes</span><span role="cell" class="no">Não incluso</span><span role="cell" class="hi yes"><Fragment set:html={ICON.check} />Incluso</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Segundo Cérebro grátis</span><span role="cell" class="yes"><Fragment set:html={ICON.check} />2 meses, plano Light</span><span role="cell" class="hi yes"><Fragment set:html={ICON.check} />3 meses, plano Max, configurado por mim</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Garantia de 7 dias</span><span role="cell" class="yes"><Fragment set:html={ICON.check} />Incluso</span><span role="cell" class="hi yes"><Fragment set:html={ICON.check} />Incluso</span></div>
        <div class="cmp__row" role="row"><span role="rowheader">Vagas ao mesmo tempo</span><span role="cell">{TOTAL_MENTORADOS}</span><span role="cell" class="hi">{VAGAS.total}</span></div>
      </div>
    </div>
  </section>

  <!-- 5. Como funciona (com a cena 3D) -->
  <section class="sec" id="como" data-sec="como" data-hue="4">
    <div class="wrap como">
      <div class="como__text">
        <div class="sec__head" data-reveal>
          <span class="eyebrow">Como funciona</span>
          <h2 class="display h2">Do problema ao <em class="hot">sistema no ar.</em></h2>
        </div>
        <ol class="passos">
          {PASSOS.map((p) => <li data-reveal><span class="passos__n">{p.n}</span><div><h3>{p.t}</h3><p>{p.d}</p></div></li>)}
        </ol>
        <button type="button" class="btn btn--hot" data-quiz data-track="como_quiz" data-reveal>Começar pelo passo 1</button>
      </div>
      <div class="como__scene" aria-hidden="true">
        <div class="como__box"><canvas data-cerebro="como"></canvas>
          <div class="como__tags"><span>dados</span><span class="hot">IA</span><span>tela</span></div>
        </div>
        <p class="como__legend">O cérebro do sistema que eu monto para você: o seu dado entra, a IA decide, a tela mostra. Dentro da sua própria estrutura.</p>
      </div>
    </div>
  </section>

  <!-- 6. Prova: mapa, depoimentos, empresas -->
  {PROVA_VISIVEL && (
  <section class="sec" id="prova" data-sec="prova" data-hue="5">
    <div class="wrap">
      <div class="mapsec">
        <div data-reveal>
          <span class="eyebrow">Pelo Brasil</span>
          <h2 class="display h2" style="margin-top:16px">Mentorados e empresas <em class="hot">pelo Brasil.</em></h2>
          <p class="lead" style="margin-top:16px">Os pontos azuis são pessoas que eu acompanho ou já acompanhei. Os laranja, empresas que já atendi. Toque em um estado para ver os números.</p>
          <div class="counters">
            <div class="counter"><b data-count={n.mentorados}>{n.mentorados}</b><span>mentorados em {n.estados} estados</span></div>
            <div class="counter counter--emp"><b data-count={n.empresas}>{n.empresas}</b><span>empresas no mapa</span></div>
          </div>
        </div>
        <div data-reveal><BrazilMap pontos={prova.mapa} /></div>
      </div>
      {VIDEOS_VISIVEIS && (
      <div class="vids" style="margin-top:var(--s6)">
        <div class="sec__head" data-reveal style="margin-bottom:var(--s3)"><span class="eyebrow">Quem já resolveu</span><h3 class="display h3">Eles contam <em class="hot">com a própria voz.</em></h3></div>
        <div class="vids__grid">
          {VIDEOS_CLIENTES.map((v, i) => v.mp4 ? (
            <figure class="vid" data-reveal>
              <video src={v.mp4} poster={v.capa || undefined} controls playsinline preload="none"></video>
              <figcaption><b>{v.nome}</b><span>{v.cargo}</span></figcaption>
            </figure>
          ) : (
            <figure class="vid vid--vazio" data-reveal aria-hidden="true">
              <div class="vid__play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>
              <figcaption><b>Depoimento {i + 1}</b><span>em vídeo, em breve</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
      )}
      {prova.depoimentos.length > 0 && (
        <div class="quotes" style="margin-top:var(--s4)">
          {prova.depoimentos.map((d) => (
            <figure class="quote glass glass--m" data-reveal>
              <blockquote>“{d.texto}”</blockquote>
              <figcaption class="who-is">{d.foto ? <img class="avatar" src={d.foto} alt="" loading="lazy" /> : <span class="avatar">{iniciais(d.nome)}</span>}<div><b>{d.nome}</b><span>{d.cargo}</span></div></figcaption>
            </figure>
          ))}
        </div>
      )}
      {prova.logos.length > 0 && (
        <div class="proof" data-reveal>
          <h3 class="proof__title">Empresas que já confiaram no nosso trabalho</h3>
          <p class="proof__hint">Toque num logo para ver o que a gente fez lá.</p>
          <div class="marquee">
            <div class="marquee__track">
              {[...prova.logos, ...prova.logos].map((l) => { const slug = l.arquivo.replace(/\.[a-z]+$/, '').replace(/\.w$/, ''); const info = EMPRESAS_INFO[slug]; const img = <img class="logo" src={`/logos/${l.arquivo}`} alt={l.nome} loading="lazy" decoding="async" style={l.altura && l.altura !== 30 ? `height:${l.altura}px` : undefined} />; return info ? <button type="button" class="logo-btn" data-empresa={slug} aria-label={`O que fizemos na ${l.nome}`}>{img}<span class="logo-btn__nome">{l.nome}</span></button> : img; })}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
  )}

  <!-- 7. O que eu já resolvi -->
  <section class="sec" id="resolvi" data-sec="projetos" data-hue="6">
    <div class="wrap" data-projects>
      <div class="sec__head" data-reveal>
        <span class="eyebrow">Projetos</span>
        <h2 class="display h2">O que eu <em class="hot">já resolvi.</em></h2>
        <p class="lead">Projetos de clientes e projetos próprios. Sem nome de cliente, porque contrato é contrato.</p>
      </div>
      <div class="projects">
        {[...destaques, ...extras].map((p, i) => (
          <article class="project glass glass--m" data-extra={p.destaque ? '0' : '1'} hidden={!p.destaque} data-reveal>
            {p.img ? <div class="project__art project__art--img"><img src={`/img/projetos/${p.img}.webp`} alt="" loading="lazy" decoding="async" /></div> : <div class="project__art" set:html={MOTIFS[p.motif]} />}
            <div class="project__body">
              {p.problema ? (
                <>
                  <span class="project__tag">O problema</span>
                  <p class="project__prob">{p.problema}</p>
                  <h3>{p.titulo}</h3>
                  <p class="project__res"><b>Resultado:</b> {p.resultado}</p>
                </>
              ) : (
                <>
                  <h3>{p.titulo}</h3>
                  <p>{p.frase}</p>
                </>
              )}
              {p.link && <a class="project__link" href={p.link.href} target="_blank" rel="noopener">{p.link.rotulo} <Fragment set:html={ICON.chevron} /></a>}
            </div>
          </article>
        ))}
      </div>
      <div class="more"><button type="button" class="btn btn--ghost" data-more aria-expanded="false">Ver todos os projetos</button></div>
    </div>
  </section>

  <!-- 8. Garantia, perguntas e chamada final -->
  <section class="sec" id="garantia" data-sec="garantia" data-hue="7" style="padding-bottom:0">
    <div class="wrap">
      <div class="guar glass" data-reveal>
        <div class="seal"><div><b>7</b><span>dias</span></div></div>
        <div>
          <h2 class="display h2">Não resolveu? Eu <em class="hot">devolvo tudo.</em></h2>
          <p>Nos primeiros 7 dias, se você achar que não vale, pede o reembolso integral, sem explicar o motivo. O risco é meu, não seu.</p>
          <a class="link" href="/reembolso">Ler a política de reembolso</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="perguntas" data-sec="perguntas" data-hue="7">
    <div class="wrap">
      <div class="sec__head" data-reveal><span class="eyebrow">Perguntas</span><h2 class="display h2">Perguntas <em class="hot">frequentes.</em></h2></div>
      <div class="faq" data-reveal>
        {FAQ.map((f) => <details><summary>{f.p}<Fragment set:html={ICON.chevron} /></summary><div class="ans">{f.r}</div></details>)}
      </div>
    </div>
  </section>

  <section class="sec" data-sec="final" data-hue="0">
    <div class="wrap">
      <div class="final glass" data-reveal>
        <canvas class="final__brain" data-cerebro="final" aria-hidden="true"></canvas>
        <h2 class="display h2">Você já sabe qual é o seu problema. <em class="hot">Falta só decidir quem vai resolver.</em></h2>
        <p class="lead">Dois minutos de perguntas e eu te digo o melhor jeito de resolver.</p>
        <button type="button" class="btn btn--hot btn--xl" data-quiz data-track="final_quiz">Começar agora</button>
        <p class="final__seal"><Fragment set:html={ICON.shield} /><span><span data-vagas-curta>{fraseVagasCurta(restantes)}</span> este mês. Garantia de 7 dias.</span></p>
      </div>
    </div>
  </section>

  <dialog class="modal" data-modal aria-labelledby="modal-titulo">
    <div class="modal__card glass glass--m">
      <button type="button" class="modal__x" data-modal-close aria-label="Fechar"><Fragment set:html={ICON.x} /></button>
      <h3 id="modal-titulo" data-modal-titulo></h3>
      <p class="modal__texto" data-modal-texto></p>
      <h4>O que a gente entregou</h4>
      <ul class="modal__feitos" data-modal-feitos></ul>
      <button type="button" class="btn btn--hot" data-quiz data-situacao="empresa" data-track="modal_empresa">Quero algo parecido na minha empresa</button>
    </div>
  </dialog>
  <script type="application/json" id="areas-data" set:html={JSON.stringify(EMPRESAS_INFO)} />
  <Quiz />
</Base>
