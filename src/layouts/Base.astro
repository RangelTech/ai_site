---
import '../styles/global.css';
import { SITE, UMAMI, LINKS, WHATSAPP, waHref } from '../data/config';
import { ICON } from '../lib/icons';

interface Props { title?: string; description?: string; path?: string; legal?: boolean }
const { title = SITE.titulo, description = SITE.descricao, path = '/', legal = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE.nome, url: SITE.url, inLanguage: 'pt-BR' },
    {
      '@type': 'Person',
      name: 'Lucas Rangel',
      jobTitle: 'Especialista em inteligência artificial',
      url: SITE.url,
      sameAs: [LINKS.instagram, LINKS.linkedin, LINKS.github, LINKS.kaggle, LINKS.portfolio],
    },
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080F" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var lowPower = (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) || (navigator.deviceMemory && navigator.deviceMemory <= 2);
        if (lowPower) document.documentElement.classList.add('lite');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {UMAMI.src && <script defer src={UMAMI.src} data-website-id={UMAMI.websiteId} data-do-not-track="true"></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="aurora" aria-hidden="true">
      <div class="scene">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
          <defs>
            <linearGradient id="base" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#050a1c" /><stop offset="0.55" stop-color="#0a1840" /><stop offset="1" stop-color="#04101f" /></linearGradient>
            <linearGradient id="f1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b4cf0" stop-opacity="0.9" /><stop offset="0.6" stop-color="#1b7fe8" stop-opacity="0.55" /><stop offset="1" stop-color="#12c2c8" stop-opacity="0.5" /></linearGradient>
            <linearGradient id="f2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#17b6c4" stop-opacity="0.75" /><stop offset="0.5" stop-color="#2358d8" stop-opacity="0.55" /><stop offset="1" stop-color="#5a35d0" stop-opacity="0.5" /></linearGradient>
            <linearGradient id="f3" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#081a48" stop-opacity="0.95" /><stop offset="1" stop-color="#2a6fe0" stop-opacity="0.5" /></linearGradient>
            <linearGradient id="brilho" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#bfe6ff" stop-opacity="0" /><stop offset="0.5" stop-color="#bfe6ff" stop-opacity="0.7" /><stop offset="1" stop-color="#bfe6ff" stop-opacity="0" /></linearGradient>
          </defs>
          <rect width="1600" height="900" fill="url(#base)" />
          <path class="s1" fill="url(#f1)" d="M-100 560C150 330 360 330 620 470S1060 700 1300 520 1620 250 1720 300V-100H-100Z" />
          <path class="s2" fill="url(#f2)" d="M-100 900C100 700 330 640 560 740S980 930 1240 760 1560 540 1720 580V1000H-100Z" />
          <path class="s3" fill="url(#f3)" d="M-100 380C140 230 330 260 540 360S900 520 1120 380 1500 120 1720 200V-100H-100Z" opacity="0.85" />
          <g fill="none" stroke="url(#brilho)" stroke-width="1.6">
            <path d="M-100 560C150 330 360 330 620 470S1060 700 1300 520 1620 250 1720 300" />
            <path d="M-100 900C100 700 330 640 560 740S980 930 1240 760 1560 540 1720 580" />
            <path d="M-100 380C140 230 330 260 540 360S900 520 1120 380 1500 120 1720 200" opacity="0.6" />
          </g>
        </svg>
      </div>
      <i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i>
      <i class="orb orb--c"></i><i class="orb orb--b"></i><i class="orb orb--a"></i>
    </div>
    <div class="grain" aria-hidden="true"></div>

    <header class="header" data-header>
      <div class="header__bar glass">
        <a class="brand" href="/" aria-label="Lucas Rangel, início">Lucas <span>Rangel</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="/#mentorias">Mentorias</a>
          <a href="/#projetos">Projetos</a>
          <a href="/#sobre">Sobre</a>
          <a href="/#perguntas">Perguntas</a>
        </nav>
        <a class="btn btn--primary btn--sm" data-wa="hero" data-track="whatsapp_header" href={waHref('hero')} target="_blank" rel="noopener">
          <Fragment set:html={ICON.message} />WhatsApp
        </a>
      </div>
    </header>

    <main id="conteudo"><slot /></main>

    <footer class="footer">
      <div class="wrap">
        <nav class="footer__links" aria-label="Rodapé">
          <a href={waHref('flutuante')} data-wa="flutuante" data-track="whatsapp_rodape" target="_blank" rel="noopener">WhatsApp</a>
          <a href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
          <a href={LINKS.portfolio} target="_blank" rel="noopener">Portfólio</a>
          <a href="/privacidade">Política de privacidade</a>
          <a href="/termos">Termos de uso</a>
          <a href="/reembolso">Política de reembolso</a>
        </nav>
        <p class="footer__legal">Rangel Technologia e Informação LTDA (Rangel Tech) · CNPJ 65.505.647/0001-10<br />Av. Rio Grande do Sul, 343, sala 03, Setor Campinas, Goiânia/GO</p>
      </div>
    </footer>

    {!legal && (
      <div class="fab" data-fab>
        <a class="btn btn--primary" data-wa="flutuante" data-track="whatsapp_flutuante" href={waHref('flutuante')} target="_blank" rel="noopener" aria-label="Falar comigo no WhatsApp">
          <Fragment set:html={ICON.message} /><span class="t">Falar no WhatsApp</span>
        </a>
      </div>
    )}

    <script>
      import '../scripts/site.ts';
    </script>
    <script is:inline define:vars={{ numero: WHATSAPP.numero, sufixo: WHATSAPP.sufixoInstagram }}>
      window.__wa = { numero: numero, sufixo: sufixo };
    </script>
  </body>
</html>
