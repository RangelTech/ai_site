---
import '../styles/global.css';
import { SITE, UMAMI, LINKS, WHATSAPP, waHref, API, TRES_D, VIDEO } from '../data/config';
import { ICON } from '../lib/icons';

interface Props { title?: string; description?: string; path?: string; legal?: boolean }
const { title = SITE.titulo, description = SITE.descricao, path = '/', legal = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE.nome, url: SITE.url, inLanguage: 'pt-BR' },
    { '@type': 'Person', name: 'Lucas Rangel', jobTitle: 'Especialista em inteligência artificial', url: SITE.url, sameAs: [LINKS.instagram, LINKS.linkedin, LINKS.github, LINKS.kaggle, LINKS.portfolio] },
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080F" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" as="image" href="/img/fundo.webp" type="image/webp" />
    <link rel="preconnect" href={API.base} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=3" type="image/x-icon" sizes="16x16" />
    <link rel="icon" href="/icon.png?v=3" type="image/png" sizes="512x512" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png?v=3" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var nav = navigator;
        var lowPower = (nav.hardwareConcurrency && nav.hardwareConcurrency <= 4) || (nav.deviceMemory && nav.deviceMemory <= 2) || (nav.connection && nav.connection.saveData);
        if (lowPower) document.documentElement.classList.add('lite');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {UMAMI.src && <script defer src={UMAMI.src} data-website-id={UMAMI.websiteId} data-do-not-track="true"></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="fundo" aria-hidden="true">
      <div class="fundo__nevoa"></div>
      <canvas class="fundo__limpo" data-limpo></canvas>
      <div class="fundo__tom"></div>
      <canvas class="fundo__brilhos" data-brilhos></canvas>
    </div>
    <div class="grain" aria-hidden="true"></div>

    <header class="header" data-header>
      <div class="header__bar glass">
        <a class="brand" href="/" aria-label="Lucas Rangel, início">
          <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12C7.97056 12 12 7.97056 12 3C12 7.97056 16.0294 12 21 12C16.0294 12 12 16.0294 12 21C12 16.0294 7.97056 12 3 12Z"/></svg>
          <span class="brand__nome">Lucas <span>Rangel</span></span>
        </a>
        <nav class="nav" aria-label="Principal">
          <a href="/#caminhos">Mentorias</a>
          <a href="/#como">Como funciona</a>
          <a href="/#resolvi">O que eu resolvi</a>
          <a href="/#perguntas">Perguntas</a>
        </nav>
        <div class="header__acoes">
          <a class="login" data-track="login_aluno" href={LINKS.aluno} rel="noopener" aria-label="Área do aluno: entrar"><span class="login__l">Área do aluno</span><svg class="login__i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></a>
          {!legal && <button class="btn btn--hot btn--sm hbtn" type="button" data-quiz data-track="quiz_header"><span>Resolver meu problema</span><span class="hbtn__s">Começar</span></button>}
        </div>
      </div>
    </header>

    <main id="conteudo"><slot /></main>

    {!legal && (
      <div class="ctabar" data-ctabar>
        <span class="ctabar__t"><b data-vagas-curta></b> este mês · garantia de 7 dias</span>
        <button type="button" class="btn btn--hot btn--sm" data-quiz data-track="quiz_barra">Resolver meu problema</button>
      </div>
    )}

    <footer class="footer">
      <div class="wrap">
        <nav class="footer__links" aria-label="Rodapé">
          <a href={waHref('rodape')} data-wa="rodape" data-track="whatsapp_rodape" target="_blank" rel="noopener">WhatsApp</a>
          <a href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
          <a href={LINKS.portfolio} target="_blank" rel="noopener">Portfólio</a>
          <a href={LINKS.aluno} rel="noopener">Área do aluno</a>
          <a href="/privacidade">Política de privacidade</a>
          <a href="/termos">Termos de uso</a>
          <a href="/reembolso">Política de reembolso</a>
        </nav>
        <p class="footer__legal">Rangel Technologia e Informação LTDA (Rangel Tech) · CNPJ 65.505.647/0001-10<br />Av. Rio Grande do Sul, 343, sala 03, Setor Campinas, Goiânia/GO</p>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
      import '../scripts/motion.ts';
    </script>
    <script is:inline define:vars={{ numero: WHATSAPP.numero, sufixo: WHATSAPP.sufixoInstagram, api: API.base, tresD: TRES_D.ligado, video: VIDEO }}>
      window.__rt = { numero: numero, sufixo: sufixo, api: api, tresD: tresD, video: video };
    </script>
  </body>
</html>
